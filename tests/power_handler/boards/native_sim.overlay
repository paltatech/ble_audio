/*
 * native_sim already defines adc0 as a zephyr,adc-emul controller (see
 * zephyr/boards/native/native_sim/native_sim.dts) with no channels or
 * reference voltage configured - both are added here, along with the
 * power_sense voltage-divider node power_handler.c reads through, kept
 * at the same 10k/40k (ratio 4) divider as the real board overlay
 * (boards/nrf5340dk_nrf5340_cpuapp.overlay) so test input values map to
 * the same real-world voltages on both.
 */

#include <zephyr/dt-bindings/adc/adc.h>

/ {
	aliases {
		power-sense = &power_sense;
	};

	power_sense: power_sense {
		compatible = "voltage-divider";
		io-channels = <&adc0 0>;
		output-ohms = <10000>;
		full-ohms = <40000>;
	};
};

&adc0 {
	ref-internal-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
